<Page
    x:Class="ControllerToggleWidget.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <!-- Follows Game Bar's theme and opacity (see ApplyTheme). -->
        <Grid x:Name="BackgroundGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,12,14,14" Spacing="12">

                <!-- Status card -->
                <Border CornerRadius="8"
                        Padding="12,10,12,10"
                        Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE7FC;"
                                  FontSize="26"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Built-in controller" Style="{ThemeResource BaseTextBlockStyle}" />
                            <TextBlock x:Name="DeviceText"
                                       Text="Connecting to the helper…"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Opacity="0.75"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Column="2"
                                Margin="12,0,0,0"
                                CornerRadius="11"
                                Padding="10,3,10,4"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse x:Name="StateDot" Width="8" Height="8" VerticalAlignment="Center" Fill="#FF8A8A8A" />
                                <TextBlock x:Name="StateText"
                                           Text="…"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Button x:Name="MainButton"
                        HorizontalAlignment="Stretch"
                        MinHeight="44"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="MainButton_Click"
                        IsEnabled="False"
                        Content="Turn off built-in controller" />

                <CheckBox x:Name="AutoCheckBox" Click="AutoCheckBox_Click" IsEnabled="False">
                    <TextBlock Text="Turn off automatically while an external controller is connected" TextWrapping="Wrap" />
                </CheckBox>

                <TextBlock x:Name="ExternalText"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           TextWrapping="Wrap"
                           Opacity="0.85" />

                <TextBlock x:Name="WarningText"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           TextWrapping="Wrap"
                           Foreground="#FFE3A33B"
                           Visibility="Collapsed" />

                <TextBlock x:Name="FooterText"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           TextWrapping="Wrap"
                           Opacity="0.6" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
